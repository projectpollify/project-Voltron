# Copy this file to .env and fill it in. .env is gitignored and must
# never be committed, pasted into a chat, or screenshotted.
#
#   cp .env.example .env
#   open -e .env        # or: nano .env
#
# Editing in an editor rather than typing at the terminal keeps these
# values out of your shell history.

# A Blockfrost project id for a CARDANO TESTNET. Must begin "preprod"
# or "preview" — the scripts refuse anything else, including mainnet.
BLOCKFROST_PROJECT_ID=""

# preprod or preview. Never mainnet: this project has no mainnet
# posture at all, and the refusal is enforced in code, not by memory.
CARDANO_NETWORK="preprod"

# The 24 recovery words of a wallet used ONLY for Voltron testnet work,
# on one line, separated by single spaces.
#
# NEVER reuse AgoraNet's TESTNET_MINT_MNEMONIC. Separate corpora,
# separate keys, separate blast radius.
#
# This is a single-mode secret: whoever holds these words holds the
# wallet, with no second factor. Acceptable here because the wallet
# holds nothing but faucet ADA. Never acceptable for real funds.
VOLTRON_MINT_MNEMONIC=""

# Optional. Who holds the authority keys, written into the authority
# document (owner ruling ⭐ #3, 2026-08-10). Defaults to "shawn".
# VOLTRON_HOLDER="shawn"
